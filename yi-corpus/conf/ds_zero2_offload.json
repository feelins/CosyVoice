{
    "comment": "12GB 单卡专用：ZeRO-2 + 优化器状态 CPU offload，把 Adam 的 m/v+fp32 主权重（约 6-7GB）挪到内存，显存只留权重+梯度+激活。注意容器 cgroup 内存上限仅 30GB（host 虽 251GB 但用不了），故 offload 的 pin_memory 关掉以留出可回收余量；数据加载侧 num_workers=0+prefetch=2 已在启动脚本控制，整体 CPU 内存压到 ~15GB 以下。",
    "train_batch_size": 2,
    "train_micro_batch_size_per_gpu": 1,
    "gradient_accumulation_steps": 2,
    "gradient_clipping": 5,
    "optimizer": {
        "type": "Adam",
        "params": {
            "lr": 1e-5,
            "betas": [0.9, 0.999],
            "eps": 1e-8,
            "weight_decay": 0.0
        }
    },
    "zero_optimization": {
        "stage": 2,
        "offload_optimizer": {
            "device": "cpu",
            "pin_memory": false
        },
        "allgather_partitions": true,
        "allgather_bucket_size": 500000000,
        "overlap_comm": true,
        "reduce_scatter": true,
        "reduce_bucket_size": 500000000,
        "contiguous_gradients": true
    },
    "bf16": {
        "enabled": true
    },
    "steps_per_print": 50,
    "wall_clock_breakdown": false
}
