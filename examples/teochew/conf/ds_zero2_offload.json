{
    "comment": "12GB 单卡（RTX 3080 Ti）专用：ZeRO-2 + 优化器状态 CPU offload。把 Adam 的 m/v（约 5.14GB）挪到内存，显存只留权重+梯度（约 5.14GB）。本机内存 251GB，随便搬。",
    "train_batch_size": 2,
    "train_micro_batch_size_per_gpu": 1,
    "gradient_accumulation_steps": 2,
    "gradient_clipping": 5,
    "optimizer": {
        "type": "Adam",
        "params": {
            "lr": 1e-5,
            "betas": [0.9, 0.999],
            "eps": 1e-8,
            "weight_decay": 0.0
        }
    },
    "zero_optimization": {
        "stage": 2,
        "offload_optimizer": {
            "device": "cpu",
            "pin_memory": true
        },
        "allgather_partitions": true,
        "allgather_bucket_size": 500000000,
        "overlap_comm": true,
        "reduce_scatter": true,
        "reduce_bucket_size": 500000000,
        "contiguous_gradients": true
    },
    "bf16": {
        "enabled": true
    },
    "steps_per_print": 50,
    "wall_clock_breakdown": false
}
